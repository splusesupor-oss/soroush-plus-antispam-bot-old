# فایل نمونه - آن را کپی کنید به .env و مقادیر را پر کنید
# cp .env.example .env

# ========= حالت یوزر-بات (پیشنهادی برای مدیریت گروه) =========
# SESSION_STRING را بعد از اولین اجرای main.py دریافت می‌کنید
SOROUSH_SESSION_STRING=
# اگر کلید API شخصی دارید (اختیاری، SPlusthon کلید پیش‌فرض دارد)
API_ID=
API_HASH=

# ========= حالت ربات رسمی (جایگزین) =========
# توکن ربات که از @MrBot در سروش پلاس می‌گیرید
BOT_TOKEN=
SOROUSH_BOT_TOKEN=

# ========= تنظیمات اضافی =========
# آیدی گروه‌های هدف (اختیاری، خالی = همه گروه‌ها)
# TARGET_GROUPS=-100123456789,-100987654321

# OpenAI-compatible AI (optional; AI remains disabled until group admin enables it)
AI_API_KEY=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=google/gemma-4-26b-a4b-it:free

AI_FALLBACK_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Optional OpenRouter attribution headers
AI_HTTP_REFERER=https://github.com/splusesupor-oss/soroush-plus-antispam-bot-old
AI_APP_TITLE=Soroush Plus Bot

AI_MAX_TOKENS=300

AI_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openai/gpt-oss-20b:free,nvidia/nemotron-3-super-120b-a12b:free
